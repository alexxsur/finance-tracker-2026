<h1>My Portfolio</h1>

<div class="search-area">
  <h3>Search Stocks</h3>
  <%= form_with url: search_stock_path, method: :get, data: { turbo_frame: "stock_search_results" } do %>
    <div class="row mb-3 g-0">
      <div class="col-sm-9">
        <%= text_field_tag :stock, params[:stock], placeholder: "Stock ticker symbol", autofocus: true, class: "form-control form-control-lg", aria: { label: "Stock ticker symbol" } %>
      </div>
      <div class="col-sm-3">
        <%= button_tag type: :submit, class: "btn btn-success btn-lg ms-sm-2", aria: { label: "Search" } do %>
          <i class="bi bi-search" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
<%= render "users/stock_search_results" %>
<% if @tracked_stocks.present? %>
  <%= render "stocks/list" %>
<% end %>
