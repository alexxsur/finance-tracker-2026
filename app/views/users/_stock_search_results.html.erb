<%= turbo_frame_tag "stock_search_results" do %>
  <% if @search_error.present? %>
    <div class="alert alert-warning results-block" role="alert">
      <%= @search_error %>
    </div>
  <% elsif @stock %>
    <div class="card results-block">
      <div class="card-body">
        <p class="mb-1"><strong>Symbol:</strong> <%= @stock.ticker %></p>
        <p class="mb-1"><strong>Name:</strong> <%= @stock.name %></p>
        <p class="mb-0"><strong>Price:</strong> <%= number_to_currency(@stock.last_price) %></p>
        <% if current_user.can_track_stock?(@stock.ticker) %>
          <%= button_to "Add to portfolio", user_stocks_path(ticker: @stock.ticker), method: :post, class: "btn btn-success mt-3", data: { turbo_frame: "_top" } %>
        <% else %>
          <span class="badge text-bg-secondary mt-3">
            You are already tracking
            <% if current_user.stock_already_tracked?(@stock.ticker) %>
              this stock.
            <% else %>
              10 stocks.
            <% end %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
