<div class="row">
  <div class="col-12 col-lg-9">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th scope="col">Ticker</th>
          <th scope="col">Name</th>
          <th scope="col">Price</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @tracked_stocks.each do |stock| %>
          <tr>
            <th scope="row"><%= stock.ticker %></th>
            <td><%= stock.name %></td>
            <td><%= number_to_currency(stock.last_price) %></td>
            <td>
              <% if @user == current_user %>
                <% user_stock = current_user.user_stocks.find_by!(stock_id: stock.id) %>
                <%= button_to "Remove", user_stock_path(user_stock), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      data: { turbo_confirm: "Are you sure you want to remove #{stock.ticker}?" } %>
              <% elsif current_user.can_track_stock?(stock.ticker) %>
                <%= button_to "Add to portfolio", user_stocks_path(ticker: stock.ticker),
                      method: :post, class: "btn btn-sm btn-success",
                      form: { data: { turbo_frame: "_top" } } %>
              <% else %>
                <span class="badge text-bg-secondary">
                  <%= current_user.stock_already_tracked?(stock.ticker) ? "Already tracking" : "10-stock limit reached" %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
