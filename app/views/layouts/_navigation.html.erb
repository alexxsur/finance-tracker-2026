<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container">
    <%= link_to "FinanceTracker", root_path, class: "navbar-brand" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "My Portfolio", my_portfolio_path,
                  class: "nav-link#{' active' if current_page?(my_portfolio_path)}",
                  aria: { current: current_page?(my_portfolio_path) ? "page" : nil } %>
          </li>
          <li class="nav-item">
            <%= link_to "My Friends", my_friends_path,
                  class: "nav-link#{' active' if current_page?(my_friends_path)}",
                  aria: { current: current_page?(my_friends_path) ? "page" : nil } %>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Profile
            </a>
            <ul class="dropdown-menu">
              <li>
                <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                  <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Edit profile
                <% end %>
              </li>
            </ul>
          </li>
        <% end %>
      </ul>
      <% if user_signed_in? %>
        <div class="d-flex align-items-center gap-3">
          <span class="navbar-text">
            <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= current_user.full_name %>
          </span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-danger btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
