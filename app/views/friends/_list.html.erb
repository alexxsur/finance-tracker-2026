<div class="table-responsive">
  <table class="table table-bordered table-hover align-middle">
    <thead>
      <tr>
        <th scope="col">Email</th>
        <th scope="col">First Name</th>
        <th scope="col">Last Name</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @friends.each do |friend| %>
        <tr>
          <td><%= friend.email %></td>
          <td><%= friend.first_name %></td>
          <td><%= friend.last_name %></td>
          <td>
            <%= link_to "View Profile", user_path(friend), class: "btn btn-sm btn-success" %>
            <% friendship = current_user.friendships.find_by!(friend_id: friend.id) %>
            <%= button_to "Stop following", friendship_path(friendship), method: :delete,
                  class: "btn btn-sm btn-warning",
                  data: { turbo_confirm: "Are you sure you want to stop following #{friend.full_name}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
